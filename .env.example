# Copie ce fichier vers .env.local puis remplis les valeurs.
# Elles se trouvent dans le dashboard Supabase : Settings → API.
# Sans ces valeurs, le site tourne en MODE DÉMO (données d'exemple, admin désactivé).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
