# Copie ce fichier vers .env.local puis remplis les valeurs.
# Sans ces valeurs, le site tourne en MODE DÉMO (données d'exemple, admin désactivé).

# ——— Supabase (base de données + login) ———
# Dashboard Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ——— Cloudinary (hébergement + optimisation des photos) ———
# Dashboard Cloudinary → page d'accueil, encart « API Keys »
# ⚠️ Seul le cloud name est public ; la clé et le secret restent côté serveur.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxxxxxxxx
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxx
